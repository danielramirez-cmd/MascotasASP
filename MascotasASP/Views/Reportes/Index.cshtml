@model IEnumerable<MascotasASP.DTOs.ReporteCreateDTO>
@{
    ViewData["Title"] = "Reporte Mascotas Grupo Salinas";
    int num = 1;
}

<div class=" container mt-4">

   
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-6">@ViewData["Title"]</h1>
    </div>

    @*  @await Html.PartialAsync("_Alerts") *@

    <div class=" table-responsive">
        <table class="table table-striped table-hover table-bordered align-middle">
            <thead class="table-dark">
                @*  Encabezados  *@
            <th>#</th>
            <th>@Html.DisplayNameFor(m => m.NombreDueno)</th>
            <th>@Html.DisplayNameFor(m => m.NombreMascota)</th>
            <th>@Html.DisplayNameFor(m => m.HoraInicio)</th>
            <th>@Html.DisplayNameFor(m => m.HoraFin)</th>
            <th>@Html.DisplayNameFor(m => m.Especie)</th>
            <th>@Html.DisplayNameFor(m => m.Paseador)</th>

            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@(num++)</td>
                            <td>@item.NombreDueno</td>
                            <td>@item.NombreMascota</td>
                            <td>@item.HoraInicio</td>
                            <td>@item.HoraFin</td>
                            <td>@item.Especie</td>
                            <td>@item.Paseador</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center">No hay categorias disponibles</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
