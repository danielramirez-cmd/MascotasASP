@model IEnumerable<MascotasASP.DTOs.AsignacionDTO>
@{
    ViewData["Title"] = "Lista de Asignacion Grupo Salinas";
    int num = 1;
}

<div class=" container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-6">@ViewData["Title"]</h1>
        <a href="@Url.Action("Create", "Asignacion")" class="btn btn-success ">
            <i class="fa-solid fa-plus"></i> Agregar nueva Asignacion Horario
        </a>
    </div>

    @*  @await Html.PartialAsync("_Alerts") *@

    <div class=" table-responsive">
        <table class="table table-striped table-hover table-bordered align-middle">
            <thead class="table-dark">
                @*  Encabezados  *@
            <th>#</th>
            <th>@Html.DisplayNameFor(m => m.Fecha)</th>
            <th>@Html.DisplayNameFor(m => m.Costo)</th>
            <th>@Html.DisplayNameFor(m => m.Paseador)</th>
            <th>@Html.DisplayNameFor(m => m.Nombre)</th>
            <th>@Html.DisplayNameFor(m => m.FechaInicio)</th>
          
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@(num++)</td>
                            <td>@item.Fecha</td>
                            <td>@item.Costo</td>
                            <td>@item.Paseador</td>
                            <td>@item.Nombre</td>
                            <td>@item.FechaInicio</td>
                      
                            <td>
                                <div class="btn-group" role="group">
                                   
                                   @*  <a href="@Url.Action("Details", "Asignacion", new { id = item.Id })" class="btn btn-sm btn-info m-2">
                                        <i class="bi bi-eye"></i> Detalles
                                    </a> *@
                                    
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center">No hay categorias disponibles</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
