@{
    ViewData["Title"] = "Bienvenido a mascotas";
}

<div class="container mt-5">
    <div class="text-center p-5 bg-light rounded shadow">
        <h1 class="display-4 text-primary mb-3">¡Bienvenido a Paseo Mascotas Grupo Salinas!</h1>
        <p class="lead mb-4">
            Gestiona fácilmente tus paseos, dueños, mascotas y horarios desde una plataforma intuitiva y rápida.
        </p>
        <a class="btn btn-primary btn-lg" href="/Asignacion">Ver Asignaciones</a>
        <a class="btn btn-outline-secondary btn-lg ms-3" href="/Mascota">Ver Mascotas</a>
    </div>

    <div class="row mt-5">
        <div class="col-md-4 text-center">
            <i class="bi bi-calendar-event display-4 text-info"></i>
            <h4 class="mt-3">Horarios</h4>
            <p>Consulta y organiza los horarios disponibles para paseos.</p>
        </div>
        <div class="col-md-4 text-center">
            <i class="bi bi-person-hearts display-4 text-success"></i>
            <h4 class="mt-3">Dueños</h4>
            <p>Mantén la información de los dueños al día y conéctalos con sus mascotas.</p>
        </div>
        <div class="col-md-4 text-center">
            <i class="bi bi-emoji-smile display-4 text-success"></i> <!-- prueba general -->
            <h4 class="mt-3">Mascotas</h4>
            <p>Agrega, edita o visualiza a todas las mascotas registradas.</p>
        </div>
    </div>
</div>
